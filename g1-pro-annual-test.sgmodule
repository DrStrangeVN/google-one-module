#!name=G1 Pro Annual Test
#!desc=v7.6.0 Bản tương thích: Dùng chung script g1-acq.js (chỉ khớp /ai?, 20/30TB 1 tháng Free fallback 90p, 2TB 12months_ip_90p); ưu tiên dùng G1 ALL IN ONE_V1 hoặc G1 ACQ
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
