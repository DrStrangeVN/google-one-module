#!name=G1 ACQ
#!desc=v7.8.0 (Bản lẻ Backup): Tự quét SKU + chẩn đoán 10 response; 20TB/30TB cố định Ultra 3 tháng 75p (.acq); 2TB g1.2tb.ai.12months_ip_90p
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
