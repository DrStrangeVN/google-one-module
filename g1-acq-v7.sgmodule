#!name=G1 ACQ
#!desc=v7.0.0: Test gói năm 2TB + giữ mapping ưu đãi 20TB/30TB & fallback 75p; kèm trang báo cáo nội bộ
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/DrStrangeVN/g1-acq-vi/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report(?:\?.*)?$,script-path=https://raw.githubusercontent.com/DrStrangeVN/g1-acq-vi/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
