#!name=G1 ALL IN ONE_V1
#!desc=v2.9.2 Studio (Liquid Glass): Bật sẵn Native Protobuf cho cả 3 gói sống (#1/#2/#3) — chạy thẳng App Google One / Gemini / Photos / Drive / Gmail không cần Google App + Thanh nổi Frame-1 + Chặn QUIC *.google.com
#!system=ios

[Rule]
# Chỉ chặn UDP 443 trên *.google.com và subscriptionsmobile-pa để ngăn Cronet gộp kết nối QUIC (không ảnh hưởng HTTP/3 ngoài Google).
AND,((DOMAIN,one.google.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,google.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,subscriptionsmobile-pa.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Header Rewrite]
http-request ^https:\/\/one\.google\.com\/ header-del Accept-Encoding
http-request ^https:\/\/one\.google\.com\/ header-del If-None-Match
http-request ^https:\/\/one\.google\.com\/ header-del If-Modified-Since
http-response ^https:\/\/one\.google\.com\/ header-del Alt-Svc

[Script]
g1-aio-v1-web = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js
g1-aio-v1-native = type=http-response,pattern=^https:\/\/subscriptionsmobile-pa\.googleapis\.com\/.*GetDynamicStorefrontInfo,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js
g1-sku-report-v1 = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report-v1.js

[MITM]
hostname = %APPEND% one.google.com, subscriptionsmobile-pa.googleapis.com
