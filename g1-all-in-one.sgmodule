#!name=G1 All-in-One
#!desc=v7.5.0 Bản gộp tối ưu: Tự động quét SKU + ghi đè 3 mức + chuyển chế độ & đổi mã 2TB ngay trên web báo cáo + thông báo iOS (chỉ cần bật 1 module này)
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-all-in-one = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
