#!name=G1 ALL IN ONE_V1
#!desc=v2.2 Hotfix Surge (max-size=-1): 6 Profile + Custom Rules an toàn + Header Rewrite chỉ nhắm trang gói (/ai,/upsell,/plans,/storage) + Kho 18 SKU + Native Protobuf

[Header Rewrite]
http-request ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-del Accept-Encoding
http-request ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-del If-None-Match
http-request ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-del If-Modified-Since
http-request ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-replace Cache-Control no-cache
http-request ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-replace Pragma no-cache
http-response ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-del Alt-Svc
http-response ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-del ETag
http-response ^https:\/\/one\.google\.com\/(?:ai|upsell|plans|storage) header-del Last-Modified

[Script]
g1-aio-v1-web = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=true,max-size=-1,binary-body-mode=false,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js
g1-aio-v1-native = type=http-response,pattern=^https:\/\/subscriptionsmobile-pa\.googleapis\.com\/.*GetDynamicStorefrontInfo,requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js
g1-sku-report-v1 = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report-v1.js

[MITM]
hostname = %APPEND% one.google.com, subscriptionsmobile-pa.googleapis.com
