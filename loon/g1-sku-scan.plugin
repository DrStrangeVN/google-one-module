#!name=G1 SKU Scan
#!desc=v7.5.0 (Bản lẻ Backup): Quét thụ động SKU từ one.google.com kèm chẩn đoán 10 response gần nhất (giữ nguyên response gốc); xem & xuất báo cáo nội bộ
#!author=DrStrangeVN
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-scan.js, requires-body=true, timeout=10, tag=g1-sku-scan
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report.js, timeout=10, tag=g1-sku-report

[MITM]
hostname = one.google.com
