#!name=G1 ACQ
#!desc=v7.0.0: Test gói năm 2TB + giữ mapping ưu đãi 20TB/30TB & fallback 75p; kèm trang báo cáo nội bộ
#!author=DrStrangeVN
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ai\? script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-acq.js, requires-body=true, timeout=10, tag=g1-acq
http-request ^https:\/\/one\.google\.com\/g1-sku-report(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report.js, timeout=10, tag=g1-sku-report

[MITM]
hostname = one.google.com
