#!name=G1 ACQ
#!desc=v7.8.0 (Bản lẻ Backup): Tự quét SKU + chẩn đoán 10 response; 20TB/30TB cố định Ultra 3 tháng 75p (.acq); 2TB g1.2tb.ai.12months_ip_90p
#!author=DrStrangeVN
#!system=ios

[Rule]
# Chặn UDP 443 để ép HTTP/3 (QUIC) lùi về TCP cho HTTPS Decryption hoạt động.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-acq.js, requires-body=true, timeout=10, tag=g1-acq
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report.js, timeout=10, tag=g1-sku-report

[MITM]
hostname = one.google.com
