#!name=G1 ALL IN ONE_V1
#!desc=v2.8 Studio (Liquid Glass): Thanh nổi 200-HTML-only an toàn đổi 5 gói tự tải lại + 7 Profile + com.google.gemini.* + Kho 32 SKU + Native Protobuf
#!author=DrStrangeVN
#!system=ios
#!homepage=https://github.com/DrStrangeVN/google-one-module
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Google.png

[Rule]
# Chỉ chặn UDP 443 trên 2 domain Google One để không ảnh hưởng HTTP/3 của các app khác.
AND,((DOMAIN,one.google.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,subscriptionsmobile-pa.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
^https:\/\/one\.google\.com\/ header-del Accept-Encoding
^https:\/\/one\.google\.com\/ header-del If-None-Match
^https:\/\/one\.google\.com\/ header-del If-Modified-Since

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js, requires-body=true, timeout=10, tag=g1-aio-v1-web
http-response ^https:\/\/subscriptionsmobile-pa\.googleapis\.com\/.*GetDynamicStorefrontInfo script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js, requires-body=true, binary-body-mode=true, timeout=10, tag=g1-aio-v1-native
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report-v1.js, timeout=10, tag=g1-sku-report-v1

[MITM]
hostname = one.google.com, subscriptionsmobile-pa.googleapis.com
