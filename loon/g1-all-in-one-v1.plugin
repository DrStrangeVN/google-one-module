#!name=G1 ALL IN ONE_V1
#!desc=v2.9.1 Studio (Loon): Cập nhật 27/11 (v7.13.0) — Top 5 gói sống (Pro 3T 99% 1-Slot 20TB / Pro tháng chính xác, TR Ultra 20TB+30TB giá cũ) + 10 Profile + Kho 33 SKU + Thanh nổi Frame-1 + Chặn QUIC *.google.com
#!openUrl=https://one.google.com/g1-sku-report
#!author=DrStrangeVN
#!homepage=https://github.com/DrStrangeVN/google-one-module
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Google.png
#!tag=Google One, Studio, SKU
#!system=ios
#!date=2026-11-27 09:00:00

[Rule]
# Chặn UDP (QUIC) trên *.google.com và subscriptionsmobile-pa để ngăn Cronet gộp kết nối QUIC né MITM (không ảnh hưởng app ngoài Google).
AND,((DOMAIN,one.google.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,google.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,subscriptionsmobile-pa.googleapis.com),(PROTOCOL,UDP)),REJECT

[Rewrite]
^https:\/\/one\.google\.com\/ header-del Accept-Encoding
^https:\/\/one\.google\.com\/ header-del If-None-Match
^https:\/\/one\.google\.com\/ header-del If-Modified-Since

[Script]
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-sku-report-v1.js, timeout=10, tag=g1-sku-report-v1, enable=true
http-response ^https:\/\/one\.google\.com\/ script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js, requires-body=true, timeout=10, tag=g1-aio-v1-web, enable=true
http-response ^https:\/\/subscriptionsmobile-pa\.googleapis\.com\/.*GetDynamicStorefrontInfo script-path=https://raw.githubusercontent.com/DrStrangeVN/google-one-module/main/g1-all-in-one-v1.js, requires-body=true, binary-body-mode=true, timeout=10, tag=g1-aio-v1-native, enable=true

[MITM]
hostname = one.google.com, subscriptionsmobile-pa.googleapis.com
